# 复制本文件为 .env.local 并填入真实值。.env.local 已被 .gitignore 忽略，
# 不会提交到仓库（题目红线：不得在公开仓库提交 API Key）。
#
# 注意：本示例文件不含任何真实密钥，可安全提交。

# —— 大模型（规划 / 综合会用到）——
# DeepSeek 官方 API（OpenAI 兼容）。不填则产品自动降级为离线规则，主链路仍可跑。
DEEPSEEK_API_KEY=sk-xxxx
# 以下两项可选，默认已可用：
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# —— 数据源：mock | fuyao | ifind ——
# mock = 内置示例数据（默认，无需任何 key，用于跑通链路）
DATA_SOURCE=mock

# —— 扶摇金融数据（同花顺金融数据 API，接入真实行情/财务时用）——
# 把 DATA_SOURCE 改成 fuyao，并填入 API Key（用同花顺账号登录
# https://fuyao.aicubes.cn 后在「API Key」处创建）。请求头为 X-api-key。
# 文档：https://fuyao.aicubes.cn/docs/
# FUYAO_BASE_URL=https://fuyao.aicubes.cn
# FUYAO_API_KEY=
